#include <WiFi.h>
#include <PubSubClient.h>

#define PIR_PIN 14
#define RELAY_PIN 26

const char* ssid = "WIFI_ANDA";
const char* password = "PASSWORD_ANDA";
const char* mqtt_server = "192.168.1.10";

WiFiClient espClient;
PubSubClient client(espClient);

bool presence = false;

void setup() {
  pinMode(PIR_PIN, INPUT);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);

  Serial.begin(115200);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  client.setServer(mqtt_server, 1883);
  client.setCallback(callback);
}

void callback(char* topic, byte* message, unsigned int length) {
  String msg;
  for (int i = 0; i < length; i++) {
    msg += (char)message[i];
  }

  if (presence && msg == "OFF") {
    Serial.println("Lamp OFF blocked (room occupied)");
    return;
  }

  if (msg == "ON") digitalWrite(RELAY_PIN, HIGH);
  if (msg == "OFF") digitalWrite(RELAY_PIN, LOW);
}

void reconnect() {
  while (!client.connected()) {
    client.connect("ESP32_KAMAR1");
    client.subscribe("rumah/jogja01/kamar1/lamp/cmd");
  }
}

void loop() {
  if (!client.connected()) reconnect();
  client.loop();

  presence = digitalRead(PIR_PIN);
  client.publish("rumah/jogja01/kamar1/occupancy",
                 presence ? "true" : "false");

  delay(2000);
}
